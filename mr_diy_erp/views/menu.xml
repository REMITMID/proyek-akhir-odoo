<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu MR DIY ERP -->
    <menuitem id="mr_diy_erp_root_menu" name="MR DIY ERP" sequence="10"/>

    <!-- Action untuk Payroll -->
    <record id="action_mr_diy_payroll" model="ir.actions.act_window">
        <field name="name">Penggajian / Payroll</field>
        <field name="res_model">mr_diy.payroll</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action untuk Quality & BASK -->
    <record id="action_mr_diy_quality" model="ir.actions.act_window">
        <field name="name">Quality Check &amp; BASK</field>
        <field name="res_model">mr_diy.quality_check</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action untuk Lowongan Website -->
    <record id="action_mr_diy_website_job" model="ir.actions.act_window">
        <field name="name">Portal Lowongan Kerja</field>
        <field name="res_model">website.job.post</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Sub-Menu di MR DIY ERP -->
    <menuitem id="mr_diy_payroll_menu" name="Payroll MR. DIY" parent="mr_diy_erp_root_menu" action="action_mr_diy_payroll" sequence="1"/>
    <menuitem id="mr_diy_quality_menu" name="Quality &amp; BASK" parent="mr_diy_erp_root_menu" action="action_mr_diy_quality" sequence="2"/>
    <menuitem id="mr_diy_website_job_menu" name="Portal Karir Website" parent="mr_diy_erp_root_menu" action="action_mr_diy_website_job" sequence="3"/>

    <!-- Views untuk Payroll -->
    <record id="view_mr_diy_payroll_tree" model="ir.ui.view">
        <field name="name">mr_diy.payroll.tree</field>
        <field name="model">mr_diy.payroll</field>
        <field name="arch" type="xml">
            <tree string="Daftar Penggajian MR. DIY">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="gaji_pokok"/>
                <field name="gaji_bersih"/>
                <field name="status_transfer" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_mr_diy_payroll_form" model="ir.ui.view">
        <field name="name">mr_diy.payroll.form</field>
        <field name="model">mr_diy.payroll</field>
        <field name="arch" type="xml">
            <form string="Form Penggajian">
                <sheet>
                    <group>
                        <group string="Informasi Karyawan &amp; Periode">
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="status_transfer"/>
                            <field name="no_referensi_bank"/>
                        </group>
                        <group string="Kalkulasi Finansial (Rp)">
                            <field name="gaji_pokok"/>
                            <field name="total_tunjangan"/>
                            <field name="lembur"/>
                            <field name="insentif"/>
                            <field name="potongan_bpjs"/>
                            <field name="potongan_pph21"/>
                            <field name="total_potongan"/>
                            <field name="gaji_bersih" style="font-weight: bold; font-size: 1.1em; color: green;"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Views untuk Quality & BASK -->
    <record id="view_mr_diy_quality_tree" model="ir.ui.view">
        <field name="name">mr_diy.quality.tree</field>
        <field name="model">mr_diy.quality_check</field>
        <field name="arch" type="xml">
            <tree string="Quality Control &amp; BASK">
                <field name="name"/>
                <field name="product_name"/>
                <field name="tgl_lapor"/>
                <field name="jumlah_rusak"/>
                <field name="jumlah_selisih"/>
                <field name="bask_claim"/>
                <field name="status_klaim" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_mr_diy_quality_form" model="ir.ui.view">
        <field name="name">mr_diy.quality.form</field>
        <field name="model">mr_diy.quality_check</field>
        <field name="arch" type="xml">
            <form string="Form BASK / Quality">
                <sheet>
                    <group>
                        <group string="Data Pemeriksaan">
                            <field name="name"/>
                            <field name="product_name"/>
                            <field name="tgl_lapor"/>
                            <field name="bask_claim"/>
                            <field name="sni_certificate"/>
                        </group>
                        <group string="Hasil Temuan Fisik">
                            <field name="jumlah_rusak"/>
                            <field name="jumlah_selisih"/>
                            <field name="status_klaim"/>
                            <field name="keterangan"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Inherit Form Views untuk Modul Bawaan -->
    <!-- 1. Accounting: Tambah Kas Non-Operasional & Audit -->
    <record id="view_move_form_mr_diy" model="ir.ui.view">
        <field name="name">account.move.form.inherit.mr_diy</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="MR DIY Accounting Extensions">
                    <field name="cash_non_operational_amount"/>
                    <field name="audit_type"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- 2. Purchase: Tambah Dokumen Bea Cukai & 3-Way Match -->
    <record id="view_purchase_order_form_mr_diy" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.mr_diy</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="MR DIY Procurement &amp; Customs">
                    <field name="customs_doc_number"/>
                    <field name="three_way_match_ok"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- 3. Fleet: Tambah Pengemudi Karyawan & Biaya BBM -->
    <record id="view_fleet_vehicle_form_mr_diy" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.mr_diy</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Logistik &amp; Armada MR. DIY">
                    <field name="driver_employee_id"/>
                    <field name="fuel_qty"/>
                    <field name="fuel_cost"/>
                    <field name="maintenance_date"/>
                    <field name="maintenance_cost"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- 4. Attendance: Tambah Denda Tidak Hadir -->
    <record id="view_hr_attendance_form_mr_diy" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.mr_diy</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Kebijakan Absensi MR DIY">
                    <field name="penalty_amount"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- 5. Inventory: Tambah Transfer Type & PDT Scan -->
    <record id="view_stock_move_form_mr_diy" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.mr_diy</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Operasional Toko &amp; CDC">
                    <field name="transfer_type"/>
                    <field name="pdt_scan_code"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
